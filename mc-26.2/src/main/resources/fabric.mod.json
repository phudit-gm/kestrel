{
	"schemaVersion": 1,
	"id": "kestrel",
	"version": "${version}",
	"name": "Kestrel",
	"description": "Bow, crossbow and trident sight: predicted flight path, target boxes, lead prediction and an optional automatic camera aim (Mode B). Client-side; servers can switch features off.",
	"authors": [
		"Khaopun"
	],
	"contact": {
		"homepage": "https://github.com/phudit-gm/kestrel",
		"sources": "https://github.com/phudit-gm/kestrel",
		"issues": "https://github.com/phudit-gm/kestrel/issues"
	},
	"license": "MIT",
	"icon": "assets/kestrel/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.khaopun.kestrel.Kestrel"
		],
		"client": [
			"com.khaopun.kestrel.KestrelClient"
		],
		"modmenu": [
			"com.khaopun.kestrel.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "kestrel.client.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"cloth-config": "*",
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
